# ============================================================================
# Controle de Faltas — variáveis de ambiente
#
# Copie para `.env.local` (que está no .gitignore) e preencha.
# Supabase → seu projeto → Settings → API
#
# Formato novo das chaves: `sb_publishable_...` substitui a antiga anon key e
# `sb_secret_...` substitui a service_role. O supabase-js v2 aceita as duas.
# ============================================================================

# --- Vão para o bundle do navegador (prefixo VITE_) -------------------------
# A anon key é PÚBLICA por design. Ela não é um segredo: quem protege os dados
# são as policies RLS da migration 0003. Se o RLS estiver certo, publicar a
# anon key é inofensivo; se estiver errado, escondê-la não salvaria nada.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- NUNCA vão para o bundle (sem prefixo VITE_) ----------------------------
# O Vite só embute variáveis que começam com VITE_, então estas ficam
# disponíveis apenas para os scripts Node de `scripts/`.
#
# A service_role key IGNORA todo o RLS. Ela existe aqui só para o seed criar
# usuários de demonstração. Nunca a coloque num arquivo VITE_*, nunca a
# comite, e revogue-a se vazar.
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
